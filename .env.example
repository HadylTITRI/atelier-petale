# Copiez ce fichier en « .env » (jamais dans GitHub) et remplissez-le.
# En ligne (Render…), ces valeurs se saisissent dans les réglages « Environment » de l'hébergeur.

# Secret qui signe les sessions admin : une longue phrase aléatoire (32 caractères minimum).
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Base MySQL : une seule des deux façons ---
# 1) Une adresse complète (Aiven, TiDB…) :
DATABASE_URL=mysql://utilisateur:motdepasse@hote:3306/nom_de_la_base
# 2) Ou champ par champ (MySQL sur votre PC) :
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=petale
# DB_PASSWORD=
# DB_NAME=atelier_petale

# Connexion chiffrée : « true » chez les hébergeurs MySQL en ligne.
DB_SSL=false
# Certificat de l'hébergeur (facultatif, recommandé) : collez le contenu, retours à la ligne remplacés par \n
# DB_SSL_CA=

# En ligne : « production » (cookies sécurisés, HTTPS imposé aux navigateurs)
NODE_ENV=development
# En ligne derrière un proxy (Render…) : « true », pour que la limitation de requêtes voie la vraie adresse du visiteur
TRUST_PROXY=false
PORT=3000
